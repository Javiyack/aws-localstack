# Valores para entorno LOCAL (LocalStack)
# Copia este archivo como terraform.tfvars y ajusta los valores

localstack        = true
environment       = "local"
aws_region        = "us-east-1"
project_name      = "pipeline"

input_stream_name  = "input-stream"
output_stream_name = "output-stream"
shard_count        = 1

dynamodb_table_name = "audit-records"

redis_host = "localhost"
redis_port = 6379

postgres_host     = "localhost"
postgres_port     = 5432
postgres_database = "pipeline"
postgres_user     = "pipeline"
postgres_password = "pipeline"

value_backend_url = "http://localhost:3333"
