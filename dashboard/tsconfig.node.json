{
  "compilerOptions": {
    "target":           "ES2022",
    "lib":              ["ES2022", "DOM"],
    "module":           "ESNext",
    "skipLibCheck":     true,
    "composite":        true,
    "moduleResolution": "bundler",
    "isolatedModules":  true,
    "moduleDetection":  "force",
    "strict":           true
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
